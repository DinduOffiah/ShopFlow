{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/identity/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/identity" }]
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/catalog/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/catalog" }]
      },
      "basket-route": {
        "ClusterId": "basket-cluster",
        "Match": { "Path": "/basket/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/basket" }]
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": { "Path": "/orders/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/orders" }]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5101/" }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5102/" }
        }
      },
      "basket-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5103/" }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5104/" }
        }
      }
    }
  }
}
